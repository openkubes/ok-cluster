# Rendered cluster directories — environment-specific but committed for reproducibility.
# These are created by: make new CLUSTER=<name>
# Note: contains Hetzner-specific IPs and node names — not portable across environments.
# GitOps migration (ok-gitops, ADR-Platform-011-candidate): rendered/ will move to
# a dedicated repo/branch; until then, commit rendered manifests here.

# macOS
.DS_Store
__MACOSX/

# Python
__pycache__/
*.pyc
.venv/
.ok125-render-*/

# Generated OK-125 evidence (reproducible, not source)
docs/adoption/OK-125/.evidence/

# Kubeconfigs — never commit
*.yaml.bak
kubeconfig*
*.kubeconfig
*.kubeconfig.yaml
.kube/
ok-infra.yaml
ok-flatcar.yaml

# But keep the example and templates
!cluster-config.yaml.example
!templates/

# OK-129: ok-kagent is described with allocation-safe inputs in Git. The
# renderer resolves private endpoints/CIDRs locally; rendered files must never
# be pushed to this public repository.
/ok-kagent/bootstrap.sh
/ok-kagent/cluster-base.yaml
/ok-kagent/cluster-v2.yaml
/ok-kagent/cluster-config.local.yaml
/ok-kagent/kagent/.values.local.yaml
# Access profile output is generated from access-config.yaml on every run.
# Committing it would create a second, drifting source of truth for RBAC.
/ok-kagent/kagent/.access.local/
